# Claude Agent Boilerplate — Environment Variables

# Required
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional
NODE_ENV=development
LOG_LEVEL=info   # error | warn | info | debug

# For web search tool (choose one):
# SERPER_API_KEY=your-serper-key      # https://serper.dev
# TAVILY_API_KEY=your-tavily-key      # https://tavily.com
# BRAVE_API_KEY=your-brave-key        # https://brave.com/search/api/
